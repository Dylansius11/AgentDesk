# syntax=docker/dockerfile:1
# Railway runs linux/amd64 images. Keep Dockerfile's linux/arm64 AgentCore
# contract intact; this is the Railway-specific build target.
FROM --platform=linux/amd64 public.ecr.aws/docker/library/python:3.12-slim-trixie

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g @trustwallet/cli@0.19.1 \
 && npm cache clean --force \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
ARG UV_INDEX_URL=""
COPY pyproject.toml ./
COPY wheels/ ./wheels/
RUN --mount=type=cache,target=/root/.cache/uv \
    sh -c 'if [ -n "$UV_INDEX_URL" ]; then export UV_INDEX_URL; else unset UV_INDEX_URL; fi; uv pip install --system --find-links ./wheels -r pyproject.toml'

COPY . .

ENV AGENT_PORT=9000
EXPOSE 9000
CMD ["opentelemetry-instrument", "python", "main.py"]
