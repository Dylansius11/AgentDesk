# AgentDesk — environment variable inventory
#
# Single source of truth is docs/technical/INTEGRATION.md ("Environment
# variables" table) — this file must stay in sync with it in the same commit
# (CLAUDE.md §4 env discipline). Copy to `.env` per app (or a root `.env` —
# dotenv/config loads from cwd) and fill in real values; never commit `.env`.
#
# NEVER put a real value for KEEPER_ATTESTER_KEY (or any private key) here or
# anywhere else in the repo — it lives only in Railway env (production) or a
# local, gitignored `.env` (dev), and is never logged (see apps/api/src/logger.ts
# and apps/keeper/src/logger.ts redaction lists).

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Supabase Postgres (pooled) — cache/derived views only, never authoritative (ERD.md §1)
DATABASE_URL=

# 8004scan public API — API key optional, raises quota.
SCAN8004_API_KEY=
SCAN8004_BASE_URL=https://8004scan.io/api/v1/public

# BSC RPC — I1/I3
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=
# Required primary archive-capable Chapel RPC for keeper historical indexing.
# Secret value lives only in a local, gitignored .env or deployment secret store.
BSC_TESTNET_ARCHIVE_RPC_URL=
# Optional secondary archive-capable Chapel RPC for read failover (never a non-archive endpoint).
BSC_TESTNET_ARCHIVE_RPC_FALLBACK_URL=


# ProofLedger (ours) — pinned at deploy time, see SMART-CONTRACT.md
PROOFLEDGER_ADDRESS_MAINNET=
PROOFLEDGER_ADDRESS_TESTNET=
ERC8004_REGISTRY_ADDRESS=

# Keeper's ONLY privileged secret — ProofLedger ATTESTER role. Never in repo, never logged.
KEEPER_ATTESTER_KEY=

# Altana (I6) — sessions, Keystore, hireErc8183Agent. CORRECTED 2026-08-17:
# @altananetwork/sdk needs NO API key / hosted backend (self-custodial, runs
# anywhere JS runs — see INTEGRATION.md I6/I14). These two are dead config,
# kept only for backward compat; the real integration point is the wallet
# key pair below.
ALTANA_API_KEY=
ALTANA_BASE_URL=https://api.altana.network

# Real Altana agent-owned wallet (self-custodial) — bootstrap wallet used by
# services/altana.ts this wave (INTEGRATION.md I6). NEVER a real value here —
# lives in a separate gitignored `apps/api/.env.altana-agent` file (mirrors
# .env.demo-agent's pattern), generated by scripts/altana-live-proof.ts.
ALTANA_WALLET_ADDRESS=
ALTANA_WALLET_PRIVATE_KEY=

# Dedicated Chapel gas sponsor for fresh per-job Altana wallets. Keep separate
# from the attester/demo/bootstrap keys; set only in local/Railway secrets.
ALTANA_FUNDING_PRIVATE_KEY=

# Self-hosted session enforcement signer (INTEGRATION.md I6 honesty note) —
# fallback path kept alongside the now-real Altana wiring above (see
# INTEGRATION.md I6 for the recommendation on which is primary going
# forward). Fresh dedicated key, only ever calls ProofLedger.registerDecision
# (no on-chain role needed — see SMART-CONTRACT.md). NEVER a real value here —
# lives in a separate gitignored `apps/api/.env.demo-agent` file (mirrors
# packages/contracts/.env.chapel-deploy's pattern), never in this shared .env.
DEMO_AGENT_ADDRESS=
DEMO_AGENT_PRIVATE_KEY=

# x402 / B402 (I5) — per-task payments, USD1 settlement
X402_FACILITATOR_URL=
PROTOCOL_FEE_BPS=300

# TermiX (I9)
TERMIX_API_KEY=

# ---------------------------------------------------------------------------
# apps/keeper
# ---------------------------------------------------------------------------
# Shares DATABASE_URL / BSC_RPC_URL / PROOFLEDGER_* / KEEPER_ATTESTER_KEY
# above. Historical Chapel indexing instead requires the primary
# BSC_TESTNET_ARCHIVE_RPC_URL above (with optional archive fallback).

# Poll interval for the indexer / attester / session-watcher loops (ARCHITECTURE.md §4.3 "every N minutes").
KEEPER_POLL_INTERVAL_MS=60000
# Safety-net full proof_metrics sweep interval (ERD.md §5 "... / hourly").
KEEPER_METRICS_INTERVAL_MS=3600000
# New var (Wave 4): block ProofLedger was deployed at, so jobs/indexer.ts's
# getContractEvents scan doesn't start from block 0. Mirrors
# exported/addresses.<network>.json's `deployedAtBlock`.
PROOFLEDGER_DEPLOY_BLOCK=
# Only commit through this many confirmations; the tip remains unindexed.
KEEPER_FINALITY_BLOCKS=15
# Re-read this bounded committed tail and compare event IDs/counts every tick.
KEEPER_REPLAY_OVERLAP_BLOCKS=128

# ---------------------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# packages/contracts (deploy scripts only — script/Deploy.s.sol)
# ---------------------------------------------------------------------------
# Distinct vars from apps/api's BSC_RPC_URL/BSC_TESTNET_RPC_URL above — these
# names match foundry.toml's [rpc_endpoints]/[etherscan] aliases exactly. See
# packages/contracts/script/README.md for the full reference + anvil dry-run.
#
# NEVER put a real PRIVATE_KEY value here or anywhere else in the repo — local,
# gitignored .env only, and only needed for Chapel/mainnet (anvil dry-runs need
# nothing: the script falls back to anvil's own published test key).
PRIVATE_KEY=
BSC_CHAPEL_RPC_URL=
BSC_MAINNET_RPC_URL=
BSCSCAN_API_KEY=
PROOFLEDGER_ADMIN_ADDRESS=
PROOFLEDGER_ATTESTER_ADDRESS=
MAINNET_CONFIRM=
