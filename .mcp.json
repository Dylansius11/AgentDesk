{
  "mcpServers": {
    "bnbchain-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@bnb-chain/mcp@latest"],
      "env": {
        "PRIVATE_KEY": ""
      }
    },
    "altana": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@altananetwork/mcp"],
      "env": {
        "ALTANA_CHAIN": "bnb-testnet"
      }
    }
  }
}
